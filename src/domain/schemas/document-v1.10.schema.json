{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triad-3d.local/schemas/document-v1.10.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "model",
    "scene",
    "nodes",
    "modifiers",
    "materials",
    "assets",
    "animations",
    "tracks",
    "keyframes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.10.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "scene": {
      "$ref": "#/$defs/scene"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "modifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modifier"
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/animation"
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "keyframes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/keyframe"
      }
    },
    "modelSnapshots": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/modelSnapshot"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "number": {
      "type": "number"
    },
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/number"
        },
        {
          "$ref": "#/$defs/number"
        },
        {
          "$ref": "#/$defs/number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "quat": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/number"
        },
        {
          "$ref": "#/$defs/number"
        },
        {
          "$ref": "#/$defs/number"
        },
        {
          "$ref": "#/$defs/number"
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "rotationQuat",
        "scale"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotationQuat": {
          "$ref": "#/$defs/quat"
        },
        "scale": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rootNodeId",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "rootNodeId": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection",
        "position",
        "target",
        "fovDegrees",
        "near",
        "far"
      ],
      "properties": {
        "projection": {
          "const": "perspective"
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "target": {
          "$ref": "#/$defs/vec3"
        },
        "fovDegrees": {
          "$ref": "#/$defs/number"
        },
        "near": {
          "$ref": "#/$defs/number"
        },
        "far": {
          "$ref": "#/$defs/number"
        }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "intensity"
      ],
      "properties": {
        "color": {
          "$ref": "#/$defs/vec3"
        },
        "environmentAssetId": {
          "$ref": "#/$defs/id"
        },
        "intensity": {
          "$ref": "#/$defs/number"
        },
        "environmentIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "environmentRotation": {
          "type": "number",
          "minimum": -6.283185307179586,
          "maximum": 6.283185307179586
        }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "color",
        "intensity",
        "position",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "ambient",
            "directional",
            "point",
            "spot"
          ]
        },
        "color": {
          "$ref": "#/$defs/vec3"
        },
        "intensity": {
          "$ref": "#/$defs/number"
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "target": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "modelId",
        "transform",
        "visible"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "modelId": {
          "$ref": "#/$defs/id"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "visible": {
          "type": "boolean"
        },
        "snapshotId": {
          "$ref": "#/$defs/id"
        },
        "materialOverride": {
          "$ref": "#/$defs/material"
        },
        "animationOverride": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clipId",
            "speed"
          ],
          "properties": {
            "clipId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            }
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "camera",
        "background",
        "lights",
        "instances"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "camera": {
          "$ref": "#/$defs/camera"
        },
        "background": {
          "$ref": "#/$defs/background"
        },
        "lights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/light"
          }
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instance"
          },
          "maxItems": 128
        },
        "renderSettings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exposure",
            "toneMapping"
          ],
          "properties": {
            "exposure": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 20
            },
            "toneMapping": {
              "enum": [
                "aces",
                "neutral",
                "none"
              ]
            }
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "materialId"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "materialId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "nodeBase": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "parentId",
        "children",
        "transform",
        "visible",
        "locked",
        "materialSlots",
        "modifierIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "group",
            "mesh"
          ]
        },
        "name": {
          "type": "string"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "materialSlots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "modifierIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "meshSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "primitive",
            "parameters"
          ],
          "properties": {
            "kind": {
              "const": "primitive"
            },
            "primitive": {
              "enum": [
                "cube",
                "sphere",
                "torus",
                "cylinder",
                "cone",
                "plane"
              ]
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/number"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "assetId"
          ],
          "properties": {
            "kind": {
              "const": "asset"
            },
            "assetId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "required": [
            "kind",
            "positions",
            "indices"
          ],
          "type": "object",
          "properties": {
            "kind": {
              "const": "editable"
            },
            "indices": {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "uv": {
              "items": {
                "$ref": "#/$defs/number"
              },
              "type": "array"
            },
            "positions": {
              "items": {
                "$ref": "#/$defs/number"
              },
              "type": "array"
            },
            "colors": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "faceMaterials": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/nodeBase"
            },
            {
              "properties": {
                "kind": {
                  "const": "group"
                }
              },
              "required": [
                "kind"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/nodeBase"
            },
            {
              "properties": {
                "kind": {
                  "const": "mesh"
                },
                "meshSource": {
                  "$ref": "#/$defs/meshSource"
                }
              },
              "required": [
                "kind",
                "meshSource"
              ]
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "modifierParameter": {
      "anyOf": [
        {
          "$ref": "#/$defs/number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/number"
          }
        }
      ]
    },
    "modifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "kind",
        "order",
        "enabled",
        "version",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "boolean",
            "mirror",
            "array",
            "bend",
            "twist",
            "taper",
            "bevel"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/modifierParameter"
          }
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "baseColor",
        "metalness",
        "roughness",
        "emissive",
        "opacity",
        "transmission",
        "ior",
        "clearcoat",
        "envIntensity",
        "textureAssetIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "baseColor": {
          "$ref": "#/$defs/vec3"
        },
        "metalness": {
          "$ref": "#/$defs/number"
        },
        "roughness": {
          "$ref": "#/$defs/number"
        },
        "emissive": {
          "$ref": "#/$defs/vec3"
        },
        "opacity": {
          "$ref": "#/$defs/number"
        },
        "transmission": {
          "$ref": "#/$defs/number"
        },
        "ior": {
          "$ref": "#/$defs/number"
        },
        "clearcoat": {
          "$ref": "#/$defs/number"
        },
        "envIntensity": {
          "$ref": "#/$defs/number"
        },
        "textureAssetIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "textureSlots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseColor": {
              "$ref": "#/$defs/id"
            },
            "normal": {
              "$ref": "#/$defs/id"
            },
            "bump": {
              "$ref": "#/$defs/id"
            },
            "roughness": {
              "$ref": "#/$defs/id"
            },
            "metalness": {
              "$ref": "#/$defs/id"
            },
            "emissive": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "textureMappings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseColor": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "const": "uv"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "axis",
                    "tiling",
                    "offset"
                  ],
                  "properties": {
                    "mode": {
                      "const": "planar"
                    },
                    "axis": {
                      "enum": [
                        "x",
                        "y",
                        "z"
                      ]
                    },
                    "tiling": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1024
                      }
                    },
                    "offset": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "tiling",
                    "offset"
                  ],
                  "properties": {
                    "mode": {
                      "const": "box"
                    },
                    "tiling": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1024
                      }
                    },
                    "offset": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "tiling",
                    "offset"
                  ],
                  "properties": {
                    "mode": {
                      "const": "triplanar"
                    },
                    "tiling": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1024
                      }
                    },
                    "offset": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "proceduralMaps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roughness": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "seed",
                    "scale",
                    "intensity",
                    "resolution"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "grain",
                        "noise",
                        "marble"
                      ]
                    },
                    "seed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 0.25,
                      "maximum": 64
                    },
                    "intensity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "resolution": {
                      "enum": [
                        128,
                        256,
                        512
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "seed",
                    "scale",
                    "intensity",
                    "resolution",
                    "directionRadians"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "scratches",
                        "brushed-metal"
                      ]
                    },
                    "seed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 0.25,
                      "maximum": 64
                    },
                    "intensity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "resolution": {
                      "enum": [
                        128,
                        256,
                        512
                      ]
                    },
                    "directionRadians": {
                      "type": "number",
                      "minimum": -3.141592653589793,
                      "maximum": 3.141592653589793
                    }
                  }
                }
              ]
            },
            "height": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "seed",
                "scale",
                "intensity",
                "resolution",
                "strength"
              ],
              "properties": {
                "kind": {
                  "const": "stone"
                },
                "seed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "scale": {
                  "type": "number",
                  "minimum": 0.25,
                  "maximum": 64
                },
                "intensity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "resolution": {
                  "enum": [
                    128,
                    256,
                    512
                  ]
                },
                "strength": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                }
              }
            }
          }
        },
        "textureStrengths": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "normal": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "bump": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hash",
        "mediaType",
        "path",
        "colorSpace"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "hash": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "colorSpace": {
          "enum": [
            "srgb",
            "linear",
            "none"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "durationSeconds",
        "loop",
        "trackIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "durationSeconds": {
          "$ref": "#/$defs/number"
        },
        "loop": {
          "type": "boolean"
        },
        "trackIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "loopStartSeconds": {
          "type": "number",
          "minimum": 0
        },
        "loopEndSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "property",
        "keyframeIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "property": {
          "enum": [
            "transform.position",
            "transform.rotationQuat",
            "transform.scale"
          ]
        },
        "keyframeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
