<file path="tests/csg/production.test.ts">
import { describe, expect, it } from "vitest";
import { BoxGeometry, Matrix4, SphereGeometry, TorusGeometry } from "three";
import { compute, makeInputs, manifoldModule } from "../../src/geometry/csg/core";
import { fromThree, operandFromThree, prepareCsgRequest, validateMesh } from "../../src/geometry/csg";
import type { MeshData } from "../../src/geometry/csg";

async function volume(mesh: MeshData) {
  const api = await manifoldModule();
  const input = new api.Mesh({ numProp: 3, vertProperties: mesh.positions.slice(), triVerts: mesh.indices.slice() });
  input.merge();
  const solid = new api.Manifold(input);
  try { return solid.volume(); } finally { solid.delete(); }
}

describe("production CSG geometry", () => {
  it("cuts the torus body and is repeatable", async () => {
    const [torus, cutter] = makeInputs("subtract", "low");
    const before = await volume(torus);
    const first = await compute("subtract", torus, cutter);
    const again = await compute("subtract", torus, cutter);
    expect(first.empty).toBe(false);
    expect(await volume(first.output)).toBeLessThan(before - 0.01);
    expect(first.faceOrigins).toContain(2);
    expect(first.output.positions).toEqual(again.output.positions);
    expect(first.output.indices).toEqual(again.output.indices);
  });

  it("unions and intersects overlapping solids with expected volumes", async () => {
    const [a, b] = makeInputs("union", "low");
    const va = await volume(a), vb = await volume(b);
    const union = await compute("union", a, b);
    const intersection = await compute("intersect", a, b);
    const vu = await volume(union.output), vi = await volume(intersection.output);
    expect(vi).toBeGreaterThan(0.1);
    expect(vi).toBeLessThan(Math.min(va, vb));
    expect(vu).toBeGreaterThan(Math.max(va, vb));
    expect(vu).toBeCloseTo(va + vb - vi, 2);
  });

  it("applies cutter world transform into target local space without mutating inputs", async () => {
    const targetGeometry = new BoxGeometry(2, 2, 2);
    const cutterGeometry = new SphereGeometry(0.6, 16, 12);
    const target = operandFromThree(targetGeometry, Array.from(new Matrix4().makeTranslation(5, 0, 0).elements));
    const cutter = operandFromThree(cutterGeometry, Array.from(new Matrix4().makeTranslation(5.8, 0, 0).elements));
    const original = cutter.mesh.positions.slice();
    const prepared = prepareCsgRequest({ jobId: "transformed", operation: "subtract", target, cutter });
    const result = await compute(prepared.operation, prepared.first, prepared.second);
    expect(await volume(result.output)).toBeLessThan(await volume(target.mesh) - 0.05);
    expect(cutter.mesh.positions).toEqual(original);
    expect(prepared.warnings.map((warning) => warning.code)).toContain("UV_DROPPED");
    expect(prepared.warnings.map((warning) => warning.code)).toContain("NORMALS_RECOMPUTED");
    expect(target.attributes?.materialGroups).toBe(true);
    expect(prepared.warnings.map((warning) => warning.code)).toContain("MATERIALS_DROPPED");
    expect(result.faceOrigins.length).toBe(result.output.indices.length / 3);
    expect(result.output).toEqual({ positions: result.output.positions, indices: result.output.indices });
    targetGeometry.dispose(); cutterGeometry.dispose();
  });

  it("rejects invalid transforms, indices, coordinates, and oversized buffers", () => {
    const [a, b] = makeInputs("union", "low");
    const base = { jobId: "bad", operation: "union" as const, target: { mesh: a }, cutter: { mesh: b } };
    expect(() => prepareCsgRequest({ ...base, cutter: { mesh: b, worldMatrix: Array(16).fill(0) } })).toThrowError(/GEOMETRY_DEGENERATE/);
    expect(() => prepareCsgRequest({ ...base, cutter: { mesh: b, worldMatrix: Array(16).fill(Infinity) } })).toThrowError(/FILE_INVALID/);
    const invalid = { positions: a.positions.slice(), indices: a.indices.slice() };
    invalid.indices[0] = invalid.positions.length;
    expect(() => validateMesh(invalid)).toThrowError(/FILE_INVALID/);
    invalid.indices[0] = a.indices[0]!; invalid.positions[0] = Infinity;
    expect(() => validateMesh(invalid)).toThrowError(/FILE_INVALID/);
    expect(() => validateMesh({ positions: new Float32Array(17_000_000), indices: new Uint32Array([0, 1, 2]) })).toThrowError(/RESOURCE_TOO_LARGE/);
  });

  it("reverses winding for a reflected cutter transform", async () => {
    const targetGeometry = new BoxGeometry(2, 2, 2);
    const cutterGeometry = new BoxGeometry(1, 1, 1);
    const target = operandFromThree(targetGeometry);
    const cutter = operandFromThree(cutterGeometry, Array.from(new Matrix4().makeScale(-1, 1, 1).elements));
    const originalIndices = cutter.mesh.indices.slice();
    const prepared = prepareCsgRequest({ jobId: "mirror", operation: "subtract", target, cutter });
    expect(prepared.second.indices[1]).toBe(originalIndices[2]);
    const result = await compute("subtract", prepared.first, prepared.second);
    expect(result.empty).toBe(false);
    expect(await volume(result.output)).toBeLessThan(await volume(target.mesh));
    expect(cutter.mesh.indices).toEqual(originalIndices);
    targetGeometry.dispose(); cutterGeometry.dispose();
  });

  it("computes a non-indexed closed mesh and leaves failed inputs intact", async () => {
    const indexed = new TorusGeometry(1.4, 0.48, 12, 24);
    const nonIndexed = indexed.toNonIndexed();
    const source = fromThree(nonIndexed);
    const [, cutter] = makeInputs("subtract", "low");
    const result = await compute("subtract", source, cutter);
    expect(result.empty).toBe(false);
    const bad = { positions: source.positions.slice(), indices: source.indices.slice() };
    bad.indices[1] = bad.indices[0]!;
    const snapshot = bad.positions.slice();
    await expect(compute("subtract", bad, cutter)).rejects.toMatchObject({ code: "GEOMETRY_DEGENERATE" });
    expect(bad.positions).toEqual(snapshot);
    indexed.dispose(); nonIndexed.dispose();
  });
});
</file>

<file path="tests/csg/service.test.ts">
import { afterEach, expect, it, vi } from "vitest";
import { CsgService } from "../../src/geometry/csg";
import { makeInputs } from "../../src/geometry/csg/core";
import type { WorkerResponse } from "../../src/geometry/csg/protocol";

class FakeWorker {
  static all: FakeWorker[] = [];
  onmessage: ((event: MessageEvent<WorkerResponse>) => void) | null = null;
  onerror: ((event: ErrorEvent) => void) | null = null;
  onmessageerror: (() => void) | null = null;
  terminated = false;
  requestId = "";
  constructor() { FakeWorker.all.push(this); }
  postMessage(request: { jobId: string }, transfer: ArrayBuffer[]) { this.requestId = request.jobId; expect(transfer).toHaveLength(4); }
  terminate() { this.terminated = true; }
  respond(data: unknown) { this.onmessage?.({ data } as MessageEvent<WorkerResponse>); }
  success() { this.respond({ jobId: this.requestId, ok: true, result: { jobId: this.requestId, coordinateSpace: "target-local", empty: true, output: { positions: new Float32Array(), indices: new Uint32Array() }, faceOrigins: new Uint8Array(), stats: { inputTriangles: 0, outputTriangles: 0, computeMs: 0 }, warnings: [] } }); }
}

afterEach(() => { vi.useRealTimers(); vi.unstubAllGlobals(); FakeWorker.all = []; });

function fixture(id: string) {
  const [a, b] = makeInputs("union", "low");
  return { jobId: id, operation: "union" as const, target: { mesh: a }, cutter: { mesh: b } };
}

it("refuses concurrent work, cancels by signal, ignores late responses and retries", async () => {
  vi.stubGlobal("Worker", FakeWorker);
  const service = new CsgService();
  const request = fixture("one");
  const source = request.target.mesh.positions.slice();
  const abort = new AbortController();
  const pending = service.run(request, abort.signal);
  await expect(service.run(fixture("two"))).rejects.toMatchObject({ code: "JOB_BUSY" });
  const old = FakeWorker.all[0]!;
  abort.abort();
  await expect(pending).rejects.toMatchObject({ code: "JOB_CANCELLED" });
  expect(old.terminated).toBe(true);
  const next = service.run(fixture("two"));
  old.success();
  FakeWorker.all[1]!.success();
  await expect(next).resolves.toMatchObject({ jobId: "two", empty: true });
  expect(request.target.mesh.positions).toEqual(source);
  service.dispose();
});

it("rejects malformed responses and Worker errors without leaving the service busy", async () => {
  vi.stubGlobal("Worker", FakeWorker);
  const service = new CsgService();
  const first = service.run(fixture("bad"));
  FakeWorker.all[0]!.respond({ nonsense: true });
  await expect(first).rejects.toMatchObject({ code: "WORKER_FAILED" });
  const second = service.run(fixture("error"));
  FakeWorker.all[1]!.onerror?.({ message: "crash" } as ErrorEvent);
  await expect(second).rejects.toMatchObject({ code: "WORKER_FAILED" });
  const third = service.run(fixture("dispose"));
  service.dispose();
  await expect(third).rejects.toMatchObject({ code: "JOB_CANCELLED" });
  expect(FakeWorker.all.every((worker) => worker.terminated)).toBe(true);
});

it("fails a silently stalled Worker and releases it", async () => {
  vi.stubGlobal("Worker", FakeWorker);
  const request = fixture("stalled");
  vi.useFakeTimers();
  const service = new CsgService();
  const pending = service.run(request);
  const assertion = expect(pending).rejects.toMatchObject({ code: "WORKER_FAILED" });
  await vi.advanceTimersByTimeAsync(5 * 60 * 1000);
  await assertion;
  expect(FakeWorker.all[0]!.terminated).toBe(true);
});
</file>

<file path="tests/domain/boolean-commands.test.ts">
import { describe, expect, it } from "vitest";
import { applyProjectPatch, createCommandBus, type ProjectCommand } from "../../src/domain/command-bus";
import { validateProject } from "../../src/domain/validate-project";
import { serializeProjectDocument, deserializeProjectDocument } from "../../src/domain";
import { createEditorStore } from "../../src/app/editor-store";
import { createNestedMeshProject } from "../fixtures/projects";

function fixture() {
  const project = createNestedMeshProject();
  const target = project.nodes.find(node => node.id === "mesh-node")!;
  const root = project.nodes.find(node => node.id === "nested-group")!;
  for (const id of ["cutter", "third"]) {
    project.nodes.push({ ...structuredClone(target), id, name: id, modifierIds: [] });
    root.children.push(id);
  }
  return project;
}
const add = (modifierId: string, nodeId = "mesh-node", cutterNodeId = "cutter"): ProjectCommand => ({
  commandId: `add-${modifierId}`, type: "ADD_BOOLEAN_MODIFIER", targetIds: [nodeId, modifierId, cutterNodeId],
  payload: { nodeId, modifierId, cutterNodeId, operation: "subtract" },
});
const update = (modifierId: string, cutterNodeId: string): ProjectCommand => ({
  commandId: `update-${modifierId}`, type: "UPDATE_BOOLEAN_MODIFIER", targetIds: [modifierId, cutterNodeId],
  payload: { modifierId, cutterNodeId, operation: "union" },
});
const enabled = (modifierId: string, value: boolean): ProjectCommand => ({
  commandId: `enabled-${modifierId}`, type: "SET_MODIFIER_ENABLED", targetIds: [modifierId], payload: { modifierId, enabled: value },
});
const move = (modifierId: string, toIndex: number): ProjectCommand => ({
  commandId: `move-${modifierId}`, type: "MOVE_MODIFIER", targetIds: [modifierId], payload: { modifierId, toIndex },
});
const remove = (modifierId: string): ProjectCommand => ({
  commandId: `remove-${modifierId}`, type: "REMOVE_MODIFIER", targetIds: [modifierId], payload: { modifierId },
});

describe("transactional Boolean commands", () => {
  it.each(["subtract", "union", "intersect"] as const)("creates %s operation", operation => {
    const bus = createCommandBus(fixture());
    const command = add("boolean");
    if (command.type !== "ADD_BOOLEAN_MODIFIER") throw new Error("Invalid test command");
    command.payload.operation = operation;
    const result = bus.executeCommand(command, 0);
    expect(result.ok).toBe(true);
    if (result.ok) expect(result.project.modifiers[0]).toMatchObject({ id: "boolean", kind: "boolean", enabled: true, version: 0, parameters: { operation, cutterNodeId: "cutter" } });
  });

  it("adds, updates, toggles, reorders and removes with reversible patches", () => {
    const bus = createCommandBus(fixture());
    const commands = [add("a"), add("b"), update("a", "third"), enabled("a", false), move("b", 0), remove("a")];
    for (const command of commands) {
      const before = bus.getSnapshot();
      const result = bus.executeCommand(command, bus.getRevision());
      expect(result.ok, JSON.stringify(result)).toBe(true);
      if (!result.ok) return;
      expect(validateProject(result.project)).toEqual([]);
      expect(applyProjectPatch(before, result.patch)).toEqual(result.project);
      expect(applyProjectPatch(result.project, result.undoPatch)).toEqual(before);
    }
    const project = bus.getSnapshot();
    expect(project.modifiers).toMatchObject([{ id: "b", order: 0, version: 1 }]);
    expect(project.nodes.find(node => node.id === "mesh-node")?.modifierIds).toEqual(["b"]);
    const saved = serializeProjectDocument(project);
    expect(saved.ok).toBe(true);
    if (saved.ok) expect(deserializeProjectDocument(saved.value)).toEqual({ ok: true, value: project });
  });

  it("rejects cycles, bad payloads and cutter deletion without changing the document", () => {
    const bus = createCommandBus(fixture());
    expect(bus.executeCommand(add("a"), 0).ok).toBe(true);
    const before = bus.getSnapshot();
    const bad = [
      add("cycle", "cutter", "mesh-node"),
      add("a"),
      add("self", "mesh-node", "mesh-node"),
      { ...add("bad"), payload: { nodeId: "mesh-node", modifierId: "bad", cutterNodeId: "cutter", operation: "xor" } } as unknown as ProjectCommand,
      move("a", 1),
      { commandId: "delete", type: "DELETE_NODE", targetIds: ["cutter"], payload: { nodeId: "cutter" } } as ProjectCommand,
    ];
    for (const command of bad) {
      expect(bus.executeCommand(command, 1).ok).toBe(false);
      expect(bus.getSnapshot()).toEqual(before);
      expect(bus.getRevision()).toBe(1);
    }
    expect(bus.executeCommand(enabled("a", false), 1).ok).toBe(true);
    expect(bus.executeCommand(add("cycle", "cutter", "mesh-node"), 2).ok).toBe(false);
  });

  it("commits one revision and history step; failed transactions and no-ops remain clean", () => {
    const store = createEditorStore(fixture());
    const initial = store.getSnapshot().document.project;
    expect(store.executeTransaction([add("a"), add("b")], 0).ok).toBe(true);
    expect(store.getSnapshot().document.revision).toBe(1);
    expect(store.getSnapshot().history.entries).toHaveLength(1);
    expect(store.getSnapshot().derived.generation).toBe(1);
    const after = structuredClone(store.getSnapshot().document.project);
    expect(store.executeCommand(enabled("a", true), 1)).toMatchObject({ ok: true, changed: false });
    expect(store.getSnapshot().history.entries).toHaveLength(1);
    expect(store.executeTransaction([update("a", "third"), add("cycle", "cutter", "mesh-node")], 1).ok).toBe(false);
    expect(store.getSnapshot().document.project).toEqual(after);
    expect(store.getSnapshot().document.revision).toBe(1);
    expect(store.undo(1).ok).toBe(true);
    expect(store.getSnapshot().document.project).toEqual(initial);
    expect(store.getSnapshot().document.dirty).toBe(false);
    expect(store.redo(2).ok).toBe(true);
    expect(store.getSnapshot().document.project).toEqual(after);
  });

  it("replays removal of multiple modifiers and permits a locked cutter", () => {
    const project = fixture();
    project.nodes.find(node => node.id === "cutter")!.locked = true;
    const bus = createCommandBus(project);
    const added = bus.executeTransaction([add("a"), add("b"), add("c")], 0);
    expect(added.ok).toBe(true);
    if (!added.ok) return;
    const result = bus.executeTransaction([remove("a"), remove("c")], 1);
    expect(result.ok, JSON.stringify(result)).toBe(true);
    if (!result.ok) return;
    expect(applyProjectPatch(added.project, result.patch)).toEqual(result.project);
    expect(applyProjectPatch(result.project, result.undoPatch)).toEqual(added.project);
  });

  it("rejects an indirect dependency cycle and a locked target", () => {
    const bus = createCommandBus(fixture());
    expect(bus.executeTransaction([add("a", "mesh-node", "cutter"), add("b", "cutter", "third")], 0).ok).toBe(true);
    const before = bus.getSnapshot();
    expect(bus.executeCommand(add("c", "third", "mesh-node"), 1)).toMatchObject({ ok: false, code: "VALIDATION_FAILED" });
    expect(bus.getSnapshot()).toEqual(before);
    const locked = fixture();
    locked.nodes.find(node => node.id === "mesh-node")!.locked = true;
    expect(createCommandBus(locked).executeCommand(add("a"), 0)).toMatchObject({ ok: false, code: "NODE_LOCKED" });
  });
});
</file>

<file path="tests/domain/hierarchy.test.ts">
import { describe, expect, it } from "vitest";
import { applyProjectPatch, createCommandBus } from "../../src/domain/command-bus";
import type { GroupNode } from "../../src/domain/types";
import { createNestedMeshProject } from "../fixtures/projects";

const blank = (id: string, parentId: string): GroupNode => ({ id, kind: "group", name: id, parentId, children: [], transform: { position: [0, 0, 0], rotationQuat: [0, 0, 0, 1], scale: [1, 1, 1] }, visible: true, locked: false, materialSlots: [], modifierIds: [] });
const move = (nodeId: string, parentId: string, index: number) => ({ commandId: `move-${nodeId}-${index}`, type: "MOVE_NODE" as const, targetIds: [nodeId, parentId] as [string, string], payload: { nodeId, parentId, index } });
describe("hierarchy commands", () => {
  it("groups, ungroups and replays delta patches", () => {
    const initial = createNestedMeshProject(); const bus = createCommandBus(initial);
    const group = blank("created", "nested-group");
    const grouped = bus.executeCommand({ commandId: "group", type: "GROUP_NODES", targetIds: ["mesh-node", group.id], payload: { nodeIds: ["mesh-node"], group } }, 0);
    expect(grouped.ok).toBe(true); if (!grouped.ok) return;
    expect(grouped.project.nodes.find(node => node.id === "mesh-node")?.parentId).toBe(group.id);
    expect(applyProjectPatch(initial, grouped.patch)).toEqual(grouped.project);
    expect(applyProjectPatch(grouped.project, grouped.undoPatch)).toEqual(initial);
    const ungrouped = bus.executeCommand({ commandId: "ungroup", type: "UNGROUP_NODE", targetIds: [group.id], payload: { nodeId: group.id } }, 1);
    expect(ungrouped.ok).toBe(true); if (!ungrouped.ok) return;
    expect(ungrouped.project.nodes.some(node => node.id === group.id)).toBe(false);
    expect(applyProjectPatch(grouped.project, ungrouped.patch)).toEqual(ungrouped.project);
    expect(applyProjectPatch(ungrouped.project, ungrouped.undoPatch)).toEqual(grouped.project);
  });
  it("preserves world coordinates, rejects cycles and shear without mutation", () => {
    const initial = createNestedMeshProject(); const root = initial.nodes[0]!;
    root.children.push("other"); initial.nodes.push(blank("other", root.id));
    initial.nodes.find(node => node.id === "nested-group")!.transform = { position: [2, 0, 0], rotationQuat: [0, 0, 0, 1], scale: [1, 1, 1] };
    initial.nodes.find(node => node.id === "mesh-node")!.transform = { position: [1, 0, 0], rotationQuat: [0, 0, 0, 1], scale: [1, 1, 1] };
    const bus = createCommandBus(initial);
    const result = bus.executeCommand(move("mesh-node", "other", 0), 0);
    expect(result.ok).toBe(true); if (!result.ok) return;
    expect(result.project.nodes.find(node => node.id === "mesh-node")?.transform.position).toEqual([3, 0, 0]);
    expect(bus.executeCommand(move("other", "other", 0), 1).ok).toBe(false);
    expect(bus.executeCommand(move(root.id, "other", 0), 1).ok).toBe(false);
    const before = bus.getSnapshot();
    const shear = structuredClone(before);
    shear.nodes.find(node => node.id === "nested-group")!.transform.scale = [2, 1, 1];
    shear.nodes.find(node => node.id === "nested-group")!.transform.rotationQuat = [0, 0, Math.sin(Math.PI / 8), Math.cos(Math.PI / 8)];
    const shearBus = createCommandBus(shear);
    const failed = shearBus.executeCommand(move("mesh-node", "nested-group", 0), 0);
    expect(failed.ok).toBe(false);
    expect(shearBus.getSnapshot()).toEqual(shear);
    expect(bus.getSnapshot()).toEqual(before);
  });
  it("reorders and deletes reversibly while protecting dependent tracks", () => {
    const initial = createNestedMeshProject(); const group = initial.nodes.find(node => node.id === "nested-group")!;
    group.children.push("second"); initial.nodes.push(blank("second", group.id));
    const bus = createCommandBus(initial);
    const reordered = bus.executeCommand(move("second", group.id, 0), 0);
    expect(reordered.ok).toBe(true); if (!reordered.ok) return;
    expect(reordered.project.nodes.find(node => node.id === group.id)?.children).toEqual(["second", "mesh-node"]);
    const deleted = bus.executeCommand({ commandId: "delete", type: "DELETE_NODE", targetIds: ["second"], payload: { nodeId: "second" } }, 1);
    expect(deleted.ok).toBe(true); if (!deleted.ok) return;
    expect(applyProjectPatch(reordered.project, deleted.patch)).toEqual(deleted.project);
    expect(applyProjectPatch(deleted.project, deleted.undoPatch)).toEqual(reordered.project);
    const dependent = createNestedMeshProject(); dependent.tracks.push({ id: "track", nodeId: "mesh-node", property: "transform.position", keyframeIds: [] });
    expect(createCommandBus(dependent).executeCommand({ commandId: "delete", type: "DELETE_NODE", targetIds: ["mesh-node"], payload: { nodeId: "mesh-node" } }, 0).ok).toBe(false);
  });
});
