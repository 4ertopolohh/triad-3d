import { createCommandBus, type ProjectCommand } from "../domain/command-bus";
import type { Project } from "../domain/types";
import { ModifierEvaluator } from "../geometry/modifiers";
import type { ArrayParameters } from "../geometry/modifiers/types";
import type { EditorStore } from "./editor-store";
import type { JobOutcome } from "./job-controller";

export type ArrayChange =
  | { type: "add"; targetId: string; parameters: ArrayParameters }
  | { type: "update"; targetId: string; modifierId: string; parameters: ArrayParameters }
  | { type: "enable"; targetId: string; modifierId: string; enabled: boolean }
  | { type: "move"; targetId: string; modifierId: string; toIndex: number }
  | { type: "remove"; targetId: string; modifierId: string };
const failure = (id: string, message: string): JobOutcome => ({ ok: false, id, status: "validation_failed", error: { code: "VALIDATION_FAILED", message } });

export async function applyArrayChange(store: EditorStore, change: ArrayChange, evaluatorFactory: () => ModifierEvaluator = () => new ModifierEvaluator()): Promise<JobOutcome> {
  const snapshot = store.getSnapshot();
  const project = snapshot.document.project;
  const target = project.nodes.find(node => node.id === change.targetId);
  const id = crypto.randomUUID();
  if (!target || target.kind !== "mesh") return failure(id, "Выберите один mesh.");
  const commandId = crypto.randomUUID();
  let command: ProjectCommand;
  if (change.type === "add") {
    const modifierId = crypto.randomUUID();
    command = { commandId, type: "ADD_ARRAY_MODIFIER", targetIds: [target.id, modifierId], payload: { nodeId: target.id, modifierId, parameters: change.parameters } };
  } else if (change.type === "update") command = { commandId, type: "UPDATE_ARRAY_MODIFIER", targetIds: [change.modifierId], payload: { modifierId: change.modifierId, parameters: change.parameters } };
  else if (change.type === "enable") command = { commandId, type: "SET_MODIFIER_ENABLED", targetIds: [change.modifierId], payload: { modifierId: change.modifierId, enabled: change.enabled } };
  else if (change.type === "move") command = { commandId, type: "MOVE_MODIFIER", targetIds: [change.modifierId], payload: { modifierId: change.modifierId, toIndex: change.toIndex } };
  else command = { commandId, type: "REMOVE_MODIFIER", targetIds: [change.modifierId], payload: { modifierId: change.modifierId } };
  const commands = [command];
  let candidate: Project;
  try {
    const bus = createCommandBus(structuredClone(project) as Project);
    const prepared = bus.executeTransaction(commands, bus.getRevision(), id);
    if (!prepared.ok) return failure(id, `${prepared.code}: ${prepared.message}${prepared.issues?.[0] ? ` ${prepared.issues[0].message}` : ""}`);
    if (!prepared.changed) return { ok: true, id, status: "succeeded", committed: false };
    candidate = prepared.project;
  } catch (error) { return failure(id, error instanceof Error ? error.message : "Не удалось проверить массив."); }
  const candidateTarget = candidate.nodes.find(node => node.id === target.id);
  if (candidateTarget?.kind === "mesh" && !candidateTarget.modifierIds.some(modifierId => candidate.modifiers.find(item => item.id === modifierId)?.enabled)) {
    const committed = store.executeTransaction(commands, snapshot.document.revision, id);
    return committed.ok ? { ok: true, id, status: "succeeded", committed: committed.changed } : failure(id, committed.message);
  }
  const evaluator = evaluatorFactory();
  try {
    return await store.jobs.run({
      id, name: "Проверка массива", cancellable: true,
      validate: input => input.revision === snapshot.document.revision && input.projectId === project.id ? null : { code: "STALE_PROJECT", message: "Проект изменился до вычисления." },
      compute: async (_input, signal) => {
        const result = await evaluator.evaluate(candidate, target.id, signal);
        return result.ok ? { ok: true as const, value: commands } : { ok: false as const, error: { code: "COMPUTE_FAILED" as const, message: `${result.error.code}: ${result.error.message}` } };
      }, commands: value => value,
    });
  } finally { evaluator.dispose(); }
}
</file>

<file path="src/app/job-controller.ts">
import type { ProjectCommand, CommandResult } from "../domain/command-bus";
import type { Project } from "../domain/types";
import type { CsgErrorCode } from "../geometry/csg/types";
import type { DeepReadonly } from "./editor-store";

export type JobErrorCode = CsgErrorCode | "VALIDATION_FAILED" | "STALE_PROJECT" | "COMMIT_FAILED" | "COMPUTE_FAILED" | "JOB_DISPOSED";
export type JobError = { readonly code: JobErrorCode; readonly message: string };
export type JobStatus = "idle" | "validating" | "validation_failed" | "running" | "cancelling" | "applying" | "succeeded" | "failed" | "cancelled";
export const isJobActive = (status: JobStatus): boolean =>
  status === "validating" || status === "running" || status === "cancelling" || status === "applying";
export type JobState = Readonly<{
  id: string | null;
  name: string | null;
  status: JobStatus;
  progress: number | null;
  cancellable: boolean;
  error: JobError | null;
}>;
export type JobOutcome =
  | { readonly ok: true; readonly id: string; readonly status: "succeeded"; readonly committed: boolean }
  | { readonly ok: false; readonly id: string; readonly status: "validation_failed" | "failed" | "cancelled"; readonly error: JobError };
export type JobComputeResult<T> = { readonly ok: true; readonly value: T } | { readonly ok: false; readonly error: JobError };
export type JobInput = Readonly<{ project: DeepReadonly<Project>; revision: number; projectId: string }>;
export type JobSpec<T> = Readonly<{
  id: string;
  name: string;
  cancellable?: boolean;
  validate: (input: JobInput) => JobError | null;
  compute: (input: JobInput, signal: AbortSignal, reportProgress: (progress: number) => void) => Promise<JobComputeResult<T>>;
  commands?: (value: T) => readonly ProjectCommand[];
}>;
export interface JobController {
  run<T>(spec: JobSpec<T>): Promise<JobOutcome>;
  cancelJob(): boolean;
  dispose(): void;
}

type Context = JobInput & { readonly identity: object; readonly epoch: object };
type Host = {
  capture(): Context;
  isCurrent(context: Context): boolean;
  publish(state: JobState): void;
  commit(commands: ProjectCommand[], revision: number, id: string): CommandResult;
};
const terminal = (id: string, status: "validation_failed" | "failed" | "cancelled", error: JobError): JobOutcome =>
  ({ ok: false, id, status, error });
const cancelled: JobError = { code: "JOB_CANCELLED", message: "Операция отменена." };

/** The host's commit capability is kept in the EditorStore closure, never exposed to compute callbacks. */
export function createJobController(host: Host): JobController {
  let current: { id: string; abort: AbortController; context: Context; canCancel: boolean; state: JobState } | null = null;
  let disposed = false;
  const show = (job: NonNullable<typeof current>, status: JobStatus, progress: number | null = job.state.progress, error: JobError | null = null) => {
    job.state = Object.freeze({ id: job.id, name: job.state.name, status, progress, cancellable: status === "running" && job.canCancel, error });
    host.publish(job.state);
  };
  const finish = (job: NonNullable<typeof current>, status: "validation_failed" | "failed" | "cancelled", error: JobError): JobOutcome => {
    if (current === job) { show(job, status, null, error); current = null; }
    return terminal(job.id, status, error);
  };
  return {
    async run<T>(spec: JobSpec<T>): Promise<JobOutcome> {
      if (current) return terminal(spec.id, "failed", { code: "JOB_BUSY", message: "Другая операция ещё выполняется." });
      if (disposed) return terminal(spec.id, "failed", { code: "JOB_DISPOSED", message: "Контроллер завершён." });
      const context = host.capture();
      const job = { id: spec.id, abort: new AbortController(), context, canCancel: !!spec.cancellable,
        state: Object.freeze({ id: spec.id, name: spec.name, status: "validating" as JobStatus, progress: null, cancellable: false, error: null }) as JobState };
      current = job;
      host.publish(job.state);
      try {
        if (!spec.id.trim() || !spec.name.trim()) return finish(job, "validation_failed", { code: "VALIDATION_FAILED", message: "Нужны ID и название операции." });
        const validation = spec.validate(context);
        if (validation) return finish(job, "validation_failed", validation);
        if (job.abort.signal.aborted || current !== job) return finish(job, "cancelled", cancelled);
        if (!host.isCurrent(context)) return finish(job, "failed", { code: "STALE_PROJECT", message: "Проект изменился до запуска вычисления." });
        show(job, "running");
        const report = (progress: number) => {
          if (current !== job || job.abort.signal.aborted || job.state.status !== "running" || !Number.isFinite(progress) || progress < 0 || progress > 1 || progress === job.state.progress) return;
          show(job, "running", progress);
        };
        const abortPromise = new Promise<"aborted">(resolve => job.abort.signal.addEventListener("abort", () => resolve("aborted"), { once: true }));
        const computation = Promise.resolve().then<JobComputeResult<T> | "aborted">(() => {
          if (job.abort.signal.aborted) return "aborted" as const;
          return spec.compute(context, job.abort.signal, report);
        });
        const result = await Promise.race([computation, abortPromise]);
        if (result === "aborted" || job.abort.signal.aborted) return finish(job, "cancelled", cancelled);
        if (!result.ok) return finish(job, result.error.code === "JOB_CANCELLED" ? "cancelled" : "failed", result.error);
        if (current !== job || !host.isCurrent(context)) return finish(job, "failed", { code: "STALE_PROJECT", message: "Проект изменился во время вычисления." });
        const commands = spec.commands?.(result.value);
        if (commands && commands.length === 0) return finish(job, "failed", { code: "COMMIT_FAILED", message: "Пустая транзакция не применяется." });
        if (job.abort.signal.aborted) return finish(job, "cancelled", cancelled);
        let committed = false;
        if (commands) {
          show(job, "applying", null);
          if (job.abort.signal.aborted || current !== job) return finish(job, "cancelled", cancelled);
          if (!host.isCurrent(context)) return finish(job, "failed", { code: "STALE_PROJECT", message: "Проект изменился до применения результата." });
          const outcome = host.commit([...commands], context.revision, spec.id);
          if (!outcome.ok) return finish(job, "failed", { code: "COMMIT_FAILED", message: `${outcome.code}: ${outcome.message}` });
          committed = outcome.changed;
        }
        show(job, "succeeded", null);
        current = null;
        return { ok: true, id: spec.id, status: "succeeded", committed };
      } catch (error) {
        if (job.abort.signal.aborted) return finish(job, "cancelled", cancelled);
        const value = error as { code?: unknown; message?: unknown };
        const code = typeof value?.code === "string" ? value.code as JobErrorCode : "COMPUTE_FAILED";
        const message = typeof value?.message === "string" ? value.message : "Ошибка вычисления.";
        return finish(job, job.state.status === "validating" ? "validation_failed" : code === "JOB_CANCELLED" ? "cancelled" : "failed", { code, message });
      }
    },
    cancelJob() {
      if (!current || current.state.status !== "running" || !current.state.cancellable) return false;
      const job = current;
      show(job, "cancelling", null);
      job.abort.abort();
      return true;
    },
    dispose() {
      disposed = true;
      if (current && isJobActive(current.state.status)) {
        const job = current;
        job.abort.abort();
        finish(job, "cancelled", cancelled);
      }
    },
  };
}
</file>

<file path="src/app/material-drag.ts">
import type { EditorStore } from "./editor-store";
import { materialPresets, type MaterialPreset } from "../materials/presets";
import { isJobActive } from "./job-controller";

export const MATERIAL_PRESET_MIME = "application/x-triad3d-material-preset";
type DragSession = { store: EditorStore; presetId: string; revision: number; epoch: object };
let session: DragSession | null = null;

export function beginMaterialDrag(store: EditorStore, presetId: string): boolean {
  if (!materialPresets.some(item => item.id === presetId)) return false;
  const state = store.getSnapshot();
  if (state.tool.mode !== "model" || isJobActive(state.job.status)) return false;
  session = { store, presetId, revision: state.document.revision, epoch: store.getProjectEpoch() };
  return true;
}

export function endMaterialDrag(): void { session = null; }

export function materialDragActive(store: EditorStore, types: readonly string[]): boolean {
  return session?.store === store && session.revision === store.getSnapshot().document.revision
    && session.epoch === store.getProjectEpoch() && types.includes(MATERIAL_PRESET_MIME);
}

export function resolveMaterialDrop(store: EditorStore, types: readonly string[], payload: string): { preset: MaterialPreset; revision: number; epoch: object } | null {
  const current = session;
  if (!current || current.store !== store || !types.includes(MATERIAL_PRESET_MIME) || current.presetId !== payload) return null;
  const preset = materialPresets.find(item => item.id === payload);
  return preset ? { preset, revision: current.revision, epoch: current.epoch } : null;
}
</file>

<file path="src/app/mirror-actions.ts">
import { createCommandBus, type ProjectCommand } from "../domain/command-bus";
import type { Project } from "../domain/types";
import { ModifierEvaluator } from "../geometry/modifiers";
import type { MirrorParameters } from "../geometry/modifiers/types";
import type { EditorStore } from "./editor-store";
import type { JobOutcome } from "./job-controller";

export type MirrorChange =
  | { type: "add"; targetId: string; parameters: MirrorParameters }
  | { type: "update"; targetId: string; modifierId: string; parameters: MirrorParameters }
  | { type: "enable"; targetId: string; modifierId: string; enabled: boolean }
  | { type: "move"; targetId: string; modifierId: string; toIndex: number }
  | { type: "remove"; targetId: string; modifierId: string };

const failure = (id: string, message: string): JobOutcome => ({ ok: false, id, status: "validation_failed", error: { code: "VALIDATION_FAILED", message } });

/** Checks the complete resulting stack on a detached document before committing one history step. */
export async function applyMirrorChange(store: EditorStore, change: MirrorChange,
  evaluatorFactory: () => ModifierEvaluator = () => new ModifierEvaluator()): Promise<JobOutcome> {
  const snapshot = store.getSnapshot();
  const epoch = store.getProjectEpoch();
  const project = snapshot.document.project;
  const target = project.nodes.find(node => node.id === change.targetId);
  const id = crypto.randomUUID();
  if (!target || target.kind !== "mesh") return failure(id, "Выберите один mesh.");
  if (target.meshSource.kind === "asset") return failure(id, "Mirror для импортированного GLB пока недоступен: нет resolver геометрии.");
  if (change.type !== "add" && (!target.modifierIds.includes(change.modifierId)
    || project.modifiers.find(item => item.id === change.modifierId)?.kind !== "mirror"))
    return failure(id, "Mirror не принадлежит выбранному mesh.");
  const commandId = crypto.randomUUID();
  let command: ProjectCommand;
  if (change.type === "add") {
    const modifierId = crypto.randomUUID();
    command = { commandId, type: "ADD_MIRROR_MODIFIER", targetIds: [target.id, modifierId], payload: { nodeId: target.id, modifierId, parameters: change.parameters } };
  } else if (change.type === "update") command = { commandId, type: "UPDATE_MIRROR_MODIFIER", targetIds: [change.modifierId], payload: { modifierId: change.modifierId, parameters: change.parameters } };
  else if (change.type === "enable") command = { commandId, type: "SET_MODIFIER_ENABLED", targetIds: [change.modifierId], payload: { modifierId: change.modifierId, enabled: change.enabled } };
  else if (change.type === "move") command = { commandId, type: "MOVE_MODIFIER", targetIds: [change.modifierId], payload: { modifierId: change.modifierId, toIndex: change.toIndex } };
  else command = { commandId, type: "REMOVE_MODIFIER", targetIds: [change.modifierId], payload: { modifierId: change.modifierId } };
  const commands = [command];
  let candidate: Project;
  try {
    const bus = createCommandBus(structuredClone(project) as Project);
    const prepared = bus.executeTransaction(commands, bus.getRevision(), id);
    if (!prepared.ok) return failure(id, `${prepared.code}: ${prepared.message}${prepared.issues?.[0] ? ` ${prepared.issues[0].message}` : ""}`);
    if (!prepared.changed) return { ok: true, id, status: "succeeded", committed: false };
    candidate = prepared.project;
  } catch (error) { return failure(id, error instanceof Error ? error.message : "Не удалось проверить Mirror."); }
  const candidateTarget = candidate.nodes.find(node => node.id === target.id);
  if (candidateTarget?.kind === "mesh" && !candidateTarget.modifierIds.some(modifierId => candidate.modifiers.find(item => item.id === modifierId)?.enabled)) {
    if (store.getProjectEpoch() !== epoch) return failure(id, "Проект заменён до применения изменения.");
    const committed = store.executeTransaction(commands, snapshot.document.revision, id);
    return committed.ok ? { ok: true, id, status: "succeeded", committed: committed.changed } : failure(id, committed.message);
  }
  const evaluator = evaluatorFactory();
  try {
    return await store.jobs.run({
      id, name: "Проверка зеркалирования", cancellable: true,
      validate: input => store.getProjectEpoch() === epoch && input.revision === snapshot.document.revision && input.projectId === project.id
        ? null : { code: "STALE_PROJECT", message: "Проект изменился до вычисления." },
      compute: async (_input, signal) => {
        const result = await evaluator.evaluate(candidate, target.id, signal);
        return result.ok ? { ok: true as const, value: commands }
          : { ok: false as const, error: { code: "COMPUTE_FAILED" as const, message: `${result.error.code}: ${result.error.message}` } };
      }, commands: value => value,
    });
  } finally { evaluator.dispose(); }
}
