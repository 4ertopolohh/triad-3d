import { useEffect, useRef, useState } from "react";
import { applyDeformChange, type DeformChange, type DeformKind } from "../app/deform-actions";
import type { DeepReadonly, EditorStore } from "../app/editor-store";
import type { Modifier } from "../domain/types";
import { parseBendParameters, parseTaperParameters, parseTwistParameters } from "../geometry/modifiers/deform";
import { parseBevelParameters } from "../geometry/modifiers/bevel";
import type { BendParameters, DeformAxis, TaperParameters, TwistParameters, BevelParameters } from "../geometry/modifiers/types";
import { parseNumber } from "./inspector-logic";

type Parameters = BendParameters | TwistParameters | TaperParameters | BevelParameters;
type Draft = { axis: DeformAxis; direction: DeformAxis; width: string; angleDegrees: string; startScale: string; endScale: string; pivot: [string, string, string] };
type Session = { epoch: object; revision: number; selection: string; modifierVersion?: number };
const labels = { bend: "Изгиб", twist: "Скручивание", taper: "Сужение / расширение", bevel: "Фаска (Bevel)" } as const;
const axes: DeformAxis[] = ["x", "y", "z"];
const defaults: Record<DeformKind, Parameters> = {
  bend: { axis: "y", direction: "x", angleDegrees: 30, pivot: [0, 0, 0] },
  twist: { axis: "y", angleDegrees: 45, pivot: [0, 0, 0] },
  taper: { axis: "y", startScale: 1, endScale: 0.8, pivot: [0, 0, 0] },
  bevel: { width: 0.1, angleDegrees: 30 },
};
function makeDraft(kind: DeformKind, parameters: Parameters): Draft {
  return { axis: "axis" in parameters ? parameters.axis : "y", direction: kind === "bend" && "direction" in parameters ? parameters.direction : "x",
    width: "width" in parameters ? String(parameters.width) : "0.1",
    angleDegrees: "angleDegrees" in parameters && parameters.angleDegrees !== undefined ? String(parameters.angleDegrees) : kind === "bevel" ? "30" : "0",
    startScale: "startScale" in parameters ? String(parameters.startScale) : "1",
    endScale: "endScale" in parameters ? String(parameters.endScale) : "0.8",
    pivot: "pivot" in parameters ? parameters.pivot.map(String) as [string, string, string] : ["0", "0", "0"] };
}
function parseDraft(kind: "bend", draft: Draft): BendParameters;
function parseDraft(kind: "twist", draft: Draft): TwistParameters;
function parseDraft(kind: "taper", draft: Draft): TaperParameters;
function parseDraft(kind: "bevel", draft: Draft): BevelParameters;
function parseDraft(kind: DeformKind, draft: Draft): Parameters;
function parseDraft(kind: DeformKind, draft: Draft): Parameters {
  const numeric = (text: string) => { const result = parseNumber(text); if (!result.ok) throw new Error(result.message); return result.value; };
  if (kind === "bevel") return parseBevelParameters({ width: numeric(draft.width), angleDegrees: numeric(draft.angleDegrees) });
  const pivot = draft.pivot.map(numeric) as [number, number, number];
  if (kind === "bend") return parseBendParameters({ axis: draft.axis, direction: draft.direction, angleDegrees: numeric(draft.angleDegrees), pivot });
  if (kind === "twist") return parseTwistParameters({ axis: draft.axis, angleDegrees: numeric(draft.angleDegrees), pivot });
  return parseTaperParameters({ axis: draft.axis, startScale: numeric(draft.startScale), endScale: numeric(draft.endScale), pivot });
}
function capture(store: EditorStore, version?: number): Session {
  const state = store.getSnapshot();
  return { epoch: store.getProjectEpoch(), revision: state.document.revision, selection: state.selection.ids.join("\u0000"), ...(version === undefined ? {} : { modifierVersion: version }) };
}
function fresh(store: EditorStore, session: Session, modifierId?: string): boolean {
  const state = store.getSnapshot();
  return store.getProjectEpoch() === session.epoch && state.document.revision === session.revision
    && state.selection.ids.join("\u0000") === session.selection && state.tool.mode === "model" && state.meshEdit.mode === "object"
    && (modifierId === undefined || state.document.project.modifiers.find(item => item.id === modifierId)?.version === session.modifierVersion);
}

function Fields({ kind, draft, setDraft, disabled }: { kind: DeformKind; draft: Draft; setDraft: (value: Draft) => void; disabled: boolean }) {
  const number = (label: string, key: "width" | "angleDegrees" | "startScale" | "endScale") =>
    <label>{label}<input type="text" inputMode="decimal" value={draft[key]} disabled={disabled} onChange={event => setDraft({ ...draft, [key]: event.target.value })} onKeyDown={event => event.stopPropagation()} /></label>;
  if (kind === "bevel") return <>{number("Ширина фаски", "width")}{number("Порог угла, °", "angleDegrees")}</>;
  return <>
    <label>Ось<select value={draft.axis} disabled={disabled} onChange={event => setDraft({ ...draft, axis: event.target.value as DeformAxis })}>{axes.map(axis => <option key={axis} value={axis}>{axis.toUpperCase()}</option>)}</select></label>
    {kind === "bend" && <label>Направление изгиба<select value={draft.direction} disabled={disabled} onChange={event => setDraft({ ...draft, direction: event.target.value as DeformAxis })}>{axes.map(axis => <option key={axis} value={axis}>{axis.toUpperCase()}</option>)}</select></label>}
    {kind !== "taper" ? number("Угол, °", "angleDegrees") : <>{number("Начальный масштаб", "startScale")}{number("Конечный масштаб", "endScale")}</>}
    <span>Pivot</span><div className="boolean-stack-actions">{(["X", "Y", "Z"] as const).map((axis, index) => <label key={axis}>{axis}<input type="text" inputMode="decimal" value={draft.pivot[index]} disabled={disabled}
      onChange={event => setDraft({ ...draft, pivot: draft.pivot.map((value, at) => at === index ? event.target.value : value) as [string, string, string] })}
      onKeyDown={event => event.stopPropagation()} /></label>)}</div>
  </>;
}

export function DeformAdd({ store, targetId, disabled, reason }: { store: EditorStore; targetId: string; disabled: boolean; reason: string }) {
  const [kind, setKind] = useState<DeformKind>("bend");
  const [draft, setDraft] = useState(() => makeDraft("bend", defaults.bend));
  const [message, setMessage] = useState("");
  const session = useRef<Session | null>(null);
  function change(value: Draft) { session.current ??= capture(store); setDraft(value); setMessage(""); }
  function reset(nextKind: DeformKind) { setKind(nextKind); setDraft(makeDraft(nextKind, defaults[nextKind])); session.current = null; setMessage(""); }
  async function add() {
    if (session.current && !fresh(store, session.current)) { setMessage("Данные изменились. Повторите ввод."); return; }
    let change: DeformChange;
    try {
      if (kind === "bend") change = { type: "add", targetId, kind, parameters: parseDraft(kind, draft) };
      else if (kind === "twist") change = { type: "add", targetId, kind, parameters: parseDraft(kind, draft) };
      else if (kind === "taper") change = { type: "add", targetId, kind, parameters: parseDraft(kind, draft) };
      else change = { type: "add", targetId, kind, parameters: parseDraft(kind, draft) };
    } catch (error) { setMessage(error instanceof Error ? error.message : "Недопустимые параметры."); return; }
    const result = await applyDeformChange(store, change);
    setMessage(result.ok ? result.committed ? kind === "bevel" ? "Фаска добавлена." : "Деформация добавлена." : "Изменений нет." : `${result.error.code}: ${result.error.message}`);
    session.current = null;
  }
  return <section className="boolean-editor" aria-label="Деформации"><h4>Деформации</h4>
    <label>Операция<select value={kind} disabled={disabled || !!reason} onChange={event => reset(event.target.value as DeformKind)}>{Object.entries(labels).map(([key, label]) => <option key={key} value={key}>{label}</option>)}</select></label>
    <div onKeyDown={event => { if (event.key === "Enter") { event.preventDefault(); event.stopPropagation(); void add(); } else if (event.key === "Escape") { event.preventDefault(); event.stopPropagation(); setDraft(makeDraft(kind, defaults[kind])); session.current = null; setMessage(""); } }}>
      <Fields kind={kind} draft={draft} setDraft={change} disabled={disabled || !!reason} />
    </div>
    <button type="button" disabled={disabled || !!reason} title={reason || undefined} onClick={() => void add()}>{kind === "bevel" ? "Добавить фаску" : "Добавить деформацию"}</button>
    {reason && <p className="panel-hint">{reason}</p>}{message && <p className="primitive-error" role="status">{message}</p>}
    <p className="panel-hint">Деформация пересчитывает нормали. Исходные UV, авторские нормали и группы материалов в MeshData результата не сохраняются.</p>
    {kind === "bevel" && <p className="panel-hint">Фаска рассчитана на выпуклые замкнутые ориентированные сетки: до 4096 треугольников и 256 срезов. Ширина должна быть меньше половины кратчайшего ребра. Открытые и невыпуклые сетки могут отклоняться; при изменении геометрии UV, авторские нормали и группы материалов не сохраняются.</p>}
  </section>;
}

export function DeformItem({ store, targetId, modifier, index, length, disabled, reason }: { store: EditorStore; targetId: string; modifier: DeepReadonly<Modifier>; index: number; length: number; disabled: boolean; reason: string }) {
  const kind = modifier.kind;
  if (kind !== "bend" && kind !== "twist" && kind !== "taper" && kind !== "bevel") return null;
  return <DeformItemForm key={`${modifier.id}:${modifier.version}`} store={store} targetId={targetId} modifier={modifier} kind={kind} index={index} length={length} disabled={disabled} reason={reason} />;
}
function DeformItemForm({ store, targetId, modifier, kind, index, length, disabled, reason }: { store: EditorStore; targetId: string; modifier: DeepReadonly<Modifier>; kind: DeformKind; index: number; length: number; disabled: boolean; reason: string }) {
  const [message, setMessage] = useState("");
  const session = useRef<Session | null>(null);
  const renderedEpoch = useRef(store.getProjectEpoch());
  const parameters = (() => { try { return kind === "bend" ? parseBendParameters(modifier.parameters) : kind === "twist" ? parseTwistParameters(modifier.parameters) : kind === "taper" ? parseTaperParameters(modifier.parameters) : parseBevelParameters(modifier.parameters); } catch { return null; } })();
  const [draft, setDraft] = useState(() => makeDraft(kind, parameters ?? defaults[kind]));
  useEffect(() => { session.current = null; }, [modifier.id, modifier.version]);
  if (!parameters) return <p className="primitive-error" role="alert">{index + 1}. Параметры деформации повреждены.</p>;
  function change(value: Draft) { session.current ??= capture(store, modifier.version); setDraft(value); setMessage(""); }
  async function run(action: DeformChange) {
    const current = store.getSnapshot();
    if (store.getProjectEpoch() !== renderedEpoch.current || current.document.project.modifiers.find(item => item.id === modifier.id)?.version !== modifier.version
      || current.selection.ids.length !== 1 || current.selection.activeId !== targetId) { setMessage("Данные изменились. Повторите действие."); return; }
    setMessage("");
    const result = await applyDeformChange(store, action);
    setMessage(result.ok ? result.committed ? "Деформация изменена." : "Изменений нет." : `${result.error.code}: ${result.error.message}`);
  }
  function update() {
    if (session.current && !fresh(store, session.current, modifier.id)) { setMessage("Данные изменились. Повторите ввод."); return; }
    try { void run({ type: "update", targetId, modifierId: modifier.id, parameters: parseDraft(kind, draft) }); }
    catch (error) { setMessage(error instanceof Error ? error.message : "Недопустимые параметры."); }
  }
  return <div className="boolean-stack-item">
    <strong>{index + 1}. {labels[kind]}</strong>
    <label className="boolean-check"><input type="checkbox" checked={modifier.enabled} disabled={disabled || !!reason} title={reason || undefined} onChange={event => void run({ type: "enable", targetId, modifierId: modifier.id, enabled: event.target.checked })} />Включён</label>
    <div onKeyDown={event => { if (event.key === "Enter") { event.preventDefault(); event.stopPropagation(); update(); } else if (event.key === "Escape") { event.preventDefault(); event.stopPropagation(); setDraft(makeDraft(kind, parameters)); session.current = null; setMessage(""); } }}>
      <Fields kind={kind} draft={draft} setDraft={change} disabled={disabled || !!reason} />
    </div>
    <button type="button" disabled={disabled || !!reason} title={reason || undefined} onClick={update}>Применить параметры</button>
    <div className="boolean-stack-actions"><button type="button" disabled={disabled || !!reason || index === 0} title={reason || undefined} onClick={() => void run({ type: "move", targetId, modifierId: modifier.id, toIndex: index - 1 })}>↑ Выше</button><button type="button" disabled={disabled || !!reason || index === length - 1} title={reason || undefined} onClick={() => void run({ type: "move", targetId, modifierId: modifier.id, toIndex: index + 1 })}>↓ Ниже</button><button type="button" disabled={disabled || !!reason} title={reason || undefined} onClick={() => void run({ type: "remove", targetId, modifierId: modifier.id })}>Удалить</button></div>
    {message && <p className="primitive-error" role="status">{message}</p>}
  </div>;
}
</file>

<file path="src/ui/MaterialLibrary.tsx">
import { useEffect, useState } from "react";
import type { EditorStore, EditorState } from "../app/editor-store";
import { applyMaterialPreset, materialTargetReason } from "../app/material-actions";
import { beginMaterialDrag, endMaterialDrag, MATERIAL_PRESET_MIME } from "../app/material-drag";
import { categories, filterPresets, matchesPreset, type MaterialCategory } from "../materials/presets";
import { getMaterialPreviews, type PreviewResult } from "../renderer/material-preview";

export function MaterialLibrary({ store, state, blocked, notice }: { store: EditorStore; state: EditorState; blocked: boolean; notice: (kind: "info" | "success" | "error", text: string) => void }) {
  const [query, setQuery] = useState("");
  const [category, setCategory] = useState<MaterialCategory | "all">("all");
  const [previews, setPreviews] = useState<PreviewResult | null>(null);
  useEffect(() => { let active = true; void getMaterialPreviews().then(result => { if (active) setPreviews(result); }); return () => { active = false; }; }, []);
  useEffect(() => () => endMaterialDrag(), []);
  const reason = blocked ? "Дождитесь завершения текущей операции." : materialTargetReason(store);
  const projectEpoch = store.getProjectEpoch();
  const selected = state.document.project.nodes.find(node => node.id === state.selection.activeId);
  const currentId = selected?.materialSlots[0]?.materialId;
  const current = currentId && state.document.project.materials.find(item => item.id === currentId);
  const results = filterPresets(query, category);
  return <div className="material-library">
    <label className="material-search">Поиск материала<input type="search" value={query} onChange={event => setQuery(event.target.value)} placeholder="Название или свойство" /></label>
    <label className="material-category">Категория<select value={category} onChange={event => setCategory(event.target.value as MaterialCategory | "all")}><option value="all">Все</option>{categories.map(item => <option key={item.id} value={item.id}>{item.label}</option>)}</select></label>
    {(query || category !== "all") && <button type="button" className="material-reset" onClick={() => { setQuery(""); setCategory("all"); }}>Сбросить фильтр</button>}
    <p className="panel-hint" role="status">{reason ?? "Перетащите пресет на Mesh или назначьте его выделенному объекту кнопкой."}</p>
    {previews?.warning && <p className="material-warning" role="status">{previews.warning}</p>}
    {!results.length && <p role="status">Материалы не найдены.</p>}
    <div className="material-cards">{results.map(preset => {
      const applied = !!current && matchesPreset(current, preset);
      const image = previews?.images.get(preset.id);
      return <div className={`material-card ${applied ? "is-applied" : ""}`} key={preset.id}
        draggable={!blocked && state.tool.mode === "model"} title="Перетащите на Mesh в 3D-виде"
        onDragStart={event => {
          if (!beginMaterialDrag(store, preset.id)) { event.preventDefault(); notice("error", "Материал сейчас нельзя перетащить."); return; }
          event.dataTransfer.setData(MATERIAL_PRESET_MIME, preset.id);
          event.dataTransfer.effectAllowed = "copy";
          event.currentTarget.classList.add("is-dragging");
        }} onDragEnd={event => { event.currentTarget.classList.remove("is-dragging"); endMaterialDrag(); }}>
        <div className="material-preview">{image ? <img src={image} alt={`3D-превью: ${preset.name}`} /> : <span>{previews ? "3D-превью недоступно" : "Загрузка 3D-превью…"}</span>}</div>
        <div className="material-card-body"><strong>{preset.name}</strong>{applied && <span className="material-applied">Назначен</span>}<p>{preset.description}</p>
          <details><summary>О материале</summary><p>Металличность: {preset.material.metalness}; шероховатость: {preset.material.roughness}; прозрачность: {preset.material.transmission}; IOR: {preset.material.ior}.</p></details>
          <button type="button" disabled={!!reason || applied} title={reason ?? (applied ? "Уже назначен" : "")} aria-label={`Назначить материал ${preset.name}`} onClick={() => {
            const result = applyMaterialPreset(store, preset, state.document.revision, state.selection.activeId ?? "", projectEpoch);
            notice(result.ok ? "success" : "error", result.message);
          }}>{applied ? "Назначен" : "Назначить"}</button>
        </div>
      </div>;
    })}</div>
  </div>;
}
</file>

<file path="tests/app/deform-actions.test.ts">
import { describe, expect, it, vi } from "vitest";
import { applyDeformChange } from "../../src/app/deform-actions";
import { createEditorStore } from "../../src/app/editor-store";
import { createProject } from "../../src/domain/create-project";
import { createPrimitiveNode } from "../../src/geometry/primitives";
import type { ModifierEvaluator } from "../../src/geometry/modifiers";

const bend = { axis: "y", direction: "x", angleDegrees: 30, pivot: [0, 0, 0] } as const;
const twist = { axis: "y", angleDegrees: 45, pivot: [0, 0, 0] } as const;
const taper = { axis: "y", startScale: 1, endScale: 0.8, pivot: [0, 0, 0] } as const;
const bevel = { width: 0.1, angleDegrees: 30 } as const;
function fixture() {
  const project = createProject(() => crypto.randomUUID());
  const root = project.nodes[0]!;
  const node = createPrimitiveNode("cube", root.id, "target");
  project.nodes.push(node); root.children.push(node.id);
  const store = createEditorStore(project);
  store.setSelection(["target"]);
  return store;
}

describe("deformation actions", () => {
  it("commits Bevel through a job and supports update, disable, remove and undo", async () => {
    const store = fixture();
    expect(await applyDeformChange(store, { type: "add", targetId: "target", kind: "bevel", parameters: bevel })).toMatchObject({ ok: true, committed: true });
    const id = store.getSnapshot().document.project.modifiers[0]!.id;
    expect(await applyDeformChange(store, { type: "update", targetId: "target", modifierId: id, parameters: { width: 0.15 } })).toMatchObject({ ok: true, committed: true });
    expect(await applyDeformChange(store, { type: "enable", targetId: "target", modifierId: id, enabled: false })).toMatchObject({ ok: true, committed: true });
    expect(await applyDeformChange(store, { type: "remove", targetId: "target", modifierId: id })).toMatchObject({ ok: true, committed: true });
    const revision = store.getSnapshot().document.revision;
    expect(store.undo(revision).ok).toBe(true);
    expect(store.getSnapshot().document.project.modifiers[0]?.id).toBe(id);
    expect(store.redo(revision + 1).ok).toBe(true);
    expect(store.getSnapshot().job.status).not.toBe("running");
  });
  it("rolls back failed Bevel geometry and invalid width", async () => {
    const store = fixture();
    const before = store.getSnapshot();
    expect((await applyDeformChange(store, { type: "add", targetId: "target", kind: "bevel", parameters: { width: 2 } })).ok).toBe(false);
    expect((await applyDeformChange(store, { type: "add", targetId: "target", kind: "bevel", parameters: { width: -1 } })).ok).toBe(false);
    expect(store.getSnapshot().document).toEqual(before.document);
    expect(store.getSnapshot().history).toEqual(before.history);
    expect(store.getSnapshot().job.status).not.toBe("running");
  });
  it("commits ordered Bend, Twist, Taper and supports update, toggle, reorder, remove and undo", async () => {
    const store = fixture();
    for (const change of [{ type: "add" as const, targetId: "target", kind: "bend" as const, parameters: bend },
      { type: "add" as const, targetId: "target", kind: "twist" as const, parameters: twist },
      { type: "add" as const, targetId: "target", kind: "taper" as const, parameters: taper }])
      expect(await applyDeformChange(store, change)).toMatchObject({ ok: true, committed: true });
    const [first, second] = store.getSnapshot().document.project.modifiers;
    expect(store.getSnapshot().document.project.modifiers.map(item => item.kind)).toEqual(["bend", "twist", "taper"]);
    expect(await applyDeformChange(store, { type: "update", targetId: "target", modifierId: first!.id, parameters: { ...bend, angleDegrees: 60 } })).toMatchObject({ ok: true, committed: true });
    const before = store.getSnapshot();
    expect(await applyDeformChange(store, { type: "update", targetId: "target", modifierId: first!.id, parameters: { ...bend, angleDegrees: 60 } })).toMatchObject({ ok: true, committed: false });
    expect(store.getSnapshot().history.entries).toHaveLength(before.history.entries.length);
    expect(await applyDeformChange(store, { type: "move", targetId: "target", modifierId: first!.id, toIndex: 2 })).toMatchObject({ ok: true, committed: true });
    expect(store.getSnapshot().document.project.nodes.find(node => node.id === "target")?.modifierIds[2]).toBe(first!.id);
    expect(await applyDeformChange(store, { type: "enable", targetId: "target", modifierId: second!.id, enabled: false })).toMatchObject({ ok: true, committed: true });
    expect(await applyDeformChange(store, { type: "remove", targetId: "target", modifierId: first!.id })).toMatchObject({ ok: true, committed: true });
    const revision = store.getSnapshot().document.revision;
    expect(store.undo(revision).ok).toBe(true);
    expect(store.getSnapshot().document.project.modifiers.some(item => item.id === first!.id)).toBe(true);
    expect(store.redo(revision + 1).ok).toBe(true);
  });
  it("leaves document and history untouched after failed evaluation", async () => {
    const store = fixture();
    const before = store.getSnapshot();
    const dispose = vi.fn();
    const factory = () => ({ evaluate: vi.fn(async () => ({ ok: false, error: { code: "GEOMETRY_DEGENERATE", message: "Некорректная сетка." } })), dispose }) as unknown as ModifierEvaluator;
    expect((await applyDeformChange(store, { type: "add", targetId: "target", kind: "bevel", parameters: bevel }, factory)).ok).toBe(false);
    expect(dispose).toHaveBeenCalledOnce();
    expect(store.getSnapshot().document).toEqual(before.document);
    expect(store.getSnapshot().history).toEqual(before.history);
  });
  it("removes the last active deformation without running an evaluator", async () => {
    const store = fixture();
    expect(await applyDeformChange(store, { type: "add", targetId: "target", kind: "bend", parameters: bend })).toMatchObject({ ok: true });
    const id = store.getSnapshot().document.project.modifiers[0]!.id;
    const factory = vi.fn();
    expect(await applyDeformChange(store, { type: "remove", targetId: "target", modifierId: id }, factory)).toMatchObject({ ok: true, committed: true });
    expect(factory).not.toHaveBeenCalled();
    expect(store.getSnapshot().document.project.modifiers).toHaveLength(0);
  });
  it("blocks an asset-backed mesh without a runtime resolver", async () => {
    const project = createProject(() => crypto.randomUUID());
    const root = project.nodes[0]!;
    const node = createPrimitiveNode("cube", root.id, "target");
    node.meshSource = { kind: "asset", assetId: "asset" };
    project.assets.push({ id: "asset", hash: "hash", mediaType: "model/gltf-binary", path: "assets/model.glb", colorSpace: "none" });
    project.nodes.push(node); root.children.push(node.id);
    const store = createEditorStore(project); store.setSelection(["target"]);
    const before = store.getSnapshot();
    expect((await applyDeformChange(store, { type: "add", targetId: "target", kind: "bend", parameters: bend })).ok).toBe(false);
    expect(store.getSnapshot().document).toEqual(before.document);
  });
  it("cancels pending work and ignores late results", async () => {
    const store = fixture();
    let release!: () => void;
    const pending = new Promise<void>(resolve => { release = resolve; });
    const dispose = vi.fn();
    const factory = () => ({ evaluate: async () => { await pending; return { ok: true }; }, dispose }) as unknown as ModifierEvaluator;
    const operation = applyDeformChange(store, { type: "add", targetId: "target", kind: "bevel", parameters: bevel }, factory);
    await vi.waitFor(() => expect(store.getSnapshot().job.status).toBe("running"));
    expect((await applyDeformChange(store, { type: "add", targetId: "target", kind: "twist", parameters: twist })).ok).toBe(false);
    expect(store.jobs.cancelJob()).toBe(true);
    expect(await operation).toMatchObject({ ok: false, status: "cancelled" });
    release(); await Promise.resolve();
    expect(store.getSnapshot().history.entries).toHaveLength(0);
    expect(dispose).toHaveBeenCalledOnce();
  });
});
