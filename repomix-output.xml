        id: lightId,
        kind: "ambient",
        color: [1, 1, 1],
        intensity: 0.8,
        position: [0, 0, 0],
        target: [0, 0, 0],
      }],
      instances: [],
    },
    nodes: [{
      id: rootId,
      kind: "group",
      name: "Модель",
